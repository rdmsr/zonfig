.{
    .title = "Example configuration",
    .entries = .{
        .{ .kind = .import, .path = "subconfig.zon" },
        .{
            .kind = .choice,
            .key = "fruit",
            .label = "Favorite fruit",
            .help = "This is a choice",
            .default = .{ .choice = "apple" },
            .options = .{ .{ .value = "apple" }, .{ .value = "banana" }, .{ .value = "orange" } },
        },
        .{
            .kind = .choice,
            .key = "build_mode",
            .label = "Build mode",
            .default = .{ .choice = "debug" },
            .options = .{
                .{ .value = "debug" },
                .{ .value = "fast" },
                .{ .value = "safe" },
                .{ .value = "small" },
            },
        },

        .{
            .kind = .string,
            .key = "name",
            .label = "Your name",
            .help = "This is a string",
            .default = .{ .string = "John" },
        },
    },
}
